# =============================================================================
# Walimah — environment PRODUKSI untuk rachmat-layli.space
#
# Pasang sebagai /etc/walimah/env, milik root, chmod 600:
#   sudo install -m 600 -o root -g root deploy/env.production.example /etc/walimah/env
#   sudo nano /etc/walimah/env        # isi seluruh nilai bertanda ISI-INI
#
# Berkas ini dipakai DUA KALI, dan itu bukan kebetulan:
#
#   1. systemd membacanya lewat EnvironmentFile= saat menjalankan layanan;
#   2. skrip build di VPS harus mem-`source`-nya SEBELUM `npm run build`.
#
# Langkah 2 wajib karena NEXT_PUBLIC_SITE_URL bersifat build-time: Next
# menanamkannya ke dalam bundel saat kompilasi (src/app/layout.tsx:41,
# metadataBase). Bila build berjalan tanpa berkas ini, nilainya jatuh ke
# http://localhost:3000 dan seluruh pratinjau tautan WhatsApp menunjuk ke
# localhost — rusak tanpa satu pun pesan galat.
# =============================================================================

# --- Aplikasi ---------------------------------------------------------------
# WAJIB https://. Cookie sesi admin memakai flag Secure di produksi
# (src/lib/auth.ts:126), sehingga di atas http:// browser tidak pernah
# mengirimkannya kembali dan login admin gagal selamanya. Caddy menerbitkan
# sertifikat Let's Encrypt otomatis begitu domain mengarah ke VPS ini.
NEXT_PUBLIC_SITE_URL=https://rachmat-layli.space
NODE_ENV=production

# Porta backend. NILAI DI BAWAH AKAN DITIMPA deploy/resolve-port.sh — VPS ini
# menampung banyak aplikasi, jadi 3000 tidak bisa diasumsikan bebas. Skrip itu
# memilih porta kosong sekali, menuliskannya ke sini, dan menyalinnya ke
# /etc/walimah/port yang dibaca Caddy. Baris ini adalah satu-satunya sumber
# kebenaran: Caddyfile dan crontab keduanya menurunkan nilainya dari sini,
# tidak ada yang memakai angka tertulis.
#
# Jangan menyetel porta acak baru pada tiap start. server.js standalone membaca
# PORT sekali dan mati EADDRINUSE bila terpakai, dan Restart=always mengubah itu
# menjadi restart-loop; sebaliknya, porta yang berubah tiap boot membuat Caddy
# dan cron menunjuk ke tempat yang salah setelah setiap restart.
PORT=3000

# Dengar hanya di loopback. Tanpa ini server.js standalone mengikat 0.0.0.0,
# sehingga porta backend dapat diakses langsung dari internet dan melewati
# seluruh header keamanan serta pembatasan /api/cron/* milik Caddy. Di VPS
# berpenghuni banyak aplikasi ini juga menghindari bentrok ikatan dengan
# layanan lain yang mendengar di alamat berbeda pada porta yang sama.
HOSTNAME=127.0.0.1

# --- Path data (WAJIB absolut) ----------------------------------------------
# Jangan pernah memakai path relatif di sini. server.js standalone menjalankan
# process.chdir(__dirname), jadi './data/app.db' menjadi
# /opt/walimah/.next/standalone/data/app.db — yang berakibat dua kerusakan:
#
#   - systemd unit memakai ProtectSystem=strict dengan ReadWritePaths=/var/walimah,
#     sehingga penulisan pertama gagal dengan EROFS;
#   - seandainya lolos pun, direktori itu ditimpa setiap deploy, jadi seluruh
#     RSVP, ucapan, dan bukti transfer tamu ikut terhapus.
DATABASE_PATH=/var/walimah/data/app.db
UPLOAD_DIR=/var/walimah/uploads
BACKUP_DIR=/var/walimah/backups
SHEET_SNAPSHOT_PATH=/var/walimah/data/snapshot.json
MAX_UPLOAD_BYTES=2097152

# --- Google Sheets ----------------------------------------------------------
# Kosongkan GOOGLE_SHEET_ID untuk sementara memakai data seed bawaan repo.
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=/etc/walimah/credentials.json
# Service account terpisah dengan scope tulis, khusus cron export (opsional).
GOOGLE_WRITE_CREDENTIALS_PATH=
SHEET_CACHE_TTL=60

# --- Keamanan (ISI-INI seluruhnya) ------------------------------------------
ADMIN_USERNAME=admin
# npm run hash-password -- "kata sandi panjang Anda"
# Setiap tanda $ WAJIB ditulis \$ — pemuat .env melakukan ekspansi variabel dan
# akan merusak hash mentah tanpa pesan galat; gejalanya login admin selalu
# ditolak. Aplikasi membuka escape ini kembali (src/lib/env.ts:60), jadi baris
# yang sama juga tepat untuk EnvironmentFile systemd.
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32   (minimal 32 karakter, divalidasi saat boot)
AUTH_SECRET=
# openssl rand -hex 16
IP_HASH_SALT=
# openssl rand -hex 24
REVALIDATE_SECRET=
# openssl rand -hex 24
CRON_SECRET=

# --- Notifikasi WhatsApp ke mempelai ----------------------------------------
# Saluran: off | webhook | whatsapp_cloud | fonnte | whatsapp_gateway
# Biarkan 'off' sampai gateway benar-benar siap; RSVP tetap tersimpan normal.
NOTIFY_CHANNEL=off
NOTIFY_EVENTS=rsvp,wish,envelope
NOTIFY_TIMEOUT_MS=8000
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RECIPIENTS=

# Isi hanya bagian yang sesuai NOTIFY_CHANNEL di atas.
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_API_VERSION=v21.0

FONNTE_TOKEN=

# Bila memakai WAHA, ingat bahwa porta bawaannya juga 3000 — pastikan ia dan
# Walimah tidak memperebutkan porta yang sama, dan tulis porta WAHA secara
# eksplisit di URL ini (bukan ${PORT}, yang merupakan porta Walimah sendiri).
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_SESSION=default
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_GATEWAY_API_KEY_HEADER=X-Api-Key
WHATSAPP_GATEWAY_TEXT_FIELD=text

# --- Retensi ----------------------------------------------------------------
BACKUP_KEEP=14
PURGE_AFTER_DAYS=90
PROOF_RETENTION_DAYS=30
