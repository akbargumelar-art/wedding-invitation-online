# =============================================================================
# Walimah — contoh environment variables (Lampiran B PRD)
# Salin menjadi .env.local (dev) atau /etc/walimah/env (produksi). JANGAN commit .env.
# =============================================================================

# --- Aplikasi ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NODE_ENV=development
PORT=3000

# --- Google Sheets (opsional saat dev) --------------------------------------
# Bila GOOGLE_SHEET_ID kosong, aplikasi memakai data seed di data/seed.json.
# Bila diisi tapi API gagal, aplikasi memakai snapshot terakhir (SHEET_SNAPSHOT_PATH).
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_PATH=./credentials/sheets-readonly.json
# Alternatif tanpa file: tempel isi JSON service account (satu baris) di sini.
GOOGLE_CREDENTIALS_JSON=
# Service account terpisah dengan scope tulis, khusus untuk cron export.
GOOGLE_WRITE_CREDENTIALS_PATH=
GOOGLE_WRITE_CREDENTIALS_JSON=
SHEET_CACHE_TTL=60
SHEET_SNAPSHOT_PATH=./data/snapshot.json

# --- Database & upload ------------------------------------------------------
DATABASE_PATH=./data/app.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_BYTES=2097152

# --- Keamanan ---------------------------------------------------------------
ADMIN_USERNAME=admin
# Buat dengan: npm run hash-password -- "kata-sandi-anda"
# PENTING: setiap tanda $ pada hash WAJIB ditulis \$ — pemuat .env melakukan
# ekspansi variabel dan akan merusak hash mentah. Aplikasi membuka escape ini
# kembali, jadi baris yang sama juga benar untuk systemd EnvironmentFile.
# Contoh: ADMIN_PASSWORD_HASH=\$argon2id\$v=19\$m=19456,t=2,p=1\$garam\$hash
ADMIN_PASSWORD_HASH=
# openssl rand -base64 32
AUTH_SECRET=ubah-nilai-ini-minimal-32-karakter-acak!!
# openssl rand -hex 16
IP_HASH_SALT=ubah-juga-nilai-ini
# openssl rand -hex 24
REVALIDATE_SECRET=ubah-juga-nilai-ini
# openssl rand -hex 24
CRON_SECRET=ubah-juga-nilai-ini

# --- Notifikasi WhatsApp ke mempelai -----------------------------------------
# Saluran: off | webhook | whatsapp_cloud | fonnte | whatsapp_gateway
NOTIFY_CHANNEL=off
# Peristiwa yang dikirim. Hapus 'visit' bila tidak ingin diberi tahu setiap
# tamu membuka undangan (dinotifikasi sekali per tamu per hari, bukan tiap buka).
NOTIFY_EVENTS=rsvp,wish,envelope,visit
NOTIFY_TIMEOUT_MS=8000
NOTIFY_MAX_ATTEMPTS=5
# Tujuan notifikasi, dipisah koma. Dipakai oleh whatsapp_cloud dan fonnte.
# Nomor biasa (format internasional tanpa +):  6281234567890
# JID WhatsApp utuh, untuk gateway berbasis chatId:
#   pribadi -> 6281234567890@c.us
#   grup    -> 120363044814127701@g.us
NOTIFY_RECIPIENTS=6281234567890

# --- Saluran: webhook (paling fleksibel) ---
# POST JSON ke URL apa pun — n8n, Make, Zapier, atau bot WhatsApp sendiri.
NOTIFY_WEBHOOK_URL=
# Bila diisi, tiap permintaan dibubuhi header x-walimah-signature=sha256=<hmac>.
NOTIFY_WEBHOOK_SECRET=

# --- Saluran: whatsapp_cloud (WhatsApp Cloud API resmi Meta) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta mewajibkan template yang sudah disetujui untuk pesan di luar jendela
# 24 jam. Template harus punya dua variabel: {{1}} judul, {{2}} rincian.
# Kosongkan hanya bila Anda yakin selalu berada dalam jendela 24 jam.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id
WHATSAPP_API_VERSION=v21.0

# --- Saluran: fonnte (gateway lokal) ---
FONNTE_TOKEN=

# --- Saluran: whatsapp_gateway (WAHA / whatsapp-web.js, berbasis chatId) ---
# Satu-satunya saluran yang dapat mengirim ke GRUP WhatsApp.
# Endpoint pengiriman teks; untuk WAHA biasanya .../api/sendText
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3000/api/sendText
WHATSAPP_GATEWAY_SESSION=default
WHATSAPP_GATEWAY_API_KEY=
# Nama header untuk API key. WAHA memakai X-Api-Key.
WHATSAPP_GATEWAY_API_KEY_HEADER=X-Api-Key
# Nama field isi pesan. WAHA memakai "text"; sebagian fork memakai "message".
WHATSAPP_GATEWAY_TEXT_FIELD=text

# --- Backup -----------------------------------------------------------------
BACKUP_DIR=./data/backups
BACKUP_KEEP=14
# Hari retensi data tamu setelah acara (PRD §4.5)
PURGE_AFTER_DAYS=90
PROOF_RETENTION_DAYS=30
